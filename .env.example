# Copie para .env e preencha.

# PostgreSQL (produção, ex.: Neon gratuito). Sem esta variável, o sistema usa um banco local
# (PGlite) no desenvolvimento; em produção ele se recusa a subir sem banco.
# DATABASE_URL=postgres://usuario:senha@host:5432/cantina

# Pasta do banco local (opcional; padrão: ~/.cantina-igreja/pglite)
# PGLITE_DIR=

# Segredo para assinar o login (obrigatório em produção). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Endereço público do site (usado no link para compartilhar no WhatsApp).
SITE_URL=http://localhost:3030

# Administrador criado por `npm run db:seed`. Sem senha aqui, é gerada uma provisória.
ADMIN_EMAIL=admin@cantina.local
ADMIN_PASSWORD=
